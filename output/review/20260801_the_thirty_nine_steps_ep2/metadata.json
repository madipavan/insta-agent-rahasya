    "hook": "\u090f\u0915 \u0938\u093e\u0927\u093e\u0930\u0923 \u091c\u0940\u0935\u0928 \u0914\u0930 \u090f\u0915 \u0930\u0939\u0938\u094d\u092f\u092e\u092f \u0905\u091c\u0928\u092c\u0940",
