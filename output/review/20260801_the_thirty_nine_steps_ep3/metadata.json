  "script": {
    "hook": "\u0916\u0924\u0930\u093e \u092c\u0922\u093c \u0930\u0939\u093e \u0939\u0948, \u0938\u091a \u091b\u0941\u092a\u093e \u0939\u0948",
    "voiceover_script": "\u092a\u093f\u091b\u0932\u0947 \u090f\u092a\u093f\u0938\u094b\u0921 \u092e\u0947\u0902 \u0939\u092e\u0928\u0947 \u0926\u0947\u0916\u093e \u0915\u093f \u090f\u0915 \u091b\u094b\u091f\u0940 \u0938\u0940 \u092e\u0941\u0932\u093e\u0915\u093e\u0924 \u0928\u0947 \u092a\u0942\u0930\u0947 \u091c\u0940\u0935\u0928 \u0915\u094b \u092c\u0926\u0932 \u0926\u093f\u092f\u093e\u0964 \u090f\u0915 \u0905\u091c\u0928\u092c\u0940 \u0915\u0947 \u0938\u093e\u0925 \u0939\u0941\u0908 \u092e\u0941\u0932\u093e\u0915\u093e\u0924 \u0928\u0947 \u090f\u0915 \u0910\u0938\u0947 \u0930\u093e\u0938\u094d\u0924\u0947 \u092a\u0930 \u091a\u0932\u093e \u0926\u093f\u092f\u093e \u091c\u0939\u093e\u0902 \u0939\u0930 \u0915\u0926\u092e \u092a\u0930 \u0916\u0924\u0930\u093e \u0939\u0948\u0964 \u0905\u092c \u0939\u0930 b\u01b0\u1edbc \u0938\u093e\u0935\u0927\u093e\u0928\u0940 \u0938\u0947 \u0909\u0920\u093e\u0928\u0940 \u0939\u094b\u0917\u0940 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092a\u0940\u091b\u0947 \u0935\u093e\u0932\u0947 \u0939\u0930 \u0915\u0926\u092e \u0915\u093e \u092e\u0924\u0932\u092c \u091c\u093e\u0928 \u0926\u0947\u0928\u093e \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0914\u0930 \u0924\u094b \u0914\u0930, \u091c\u094b \u0926\u093f\u0916 \u0930\u0939\u093e \u0939\u0948 \u0935\u0939 \u0938\u091a \u0928\u0939\u0940\u0902 \u0939\u0948, \u0939\u0930 \u091a\u0947\u0939\u0930\u0947 \u0915\u0947 \u092a\u0940\u091b\u0947 \u090f\u0915 \u0928\u0915\u093e\u092c \u0939\u0948\u0964 \u0915\u094c\u0928 \u0939\u0948 \u0905\u0938\u0932\u0940 \u0926\u0941\u0936\u094d\u092e\u0928 \u0914\u0930 \u0915\u094d\u092f\u093e \u0939\u0948 \u0907\u0938 \u0916\u0924\u0930\u0928\u093e\u0915 \u0916\u0947\u0932 \u0915\u093e \u092e\u0915\u0938\u0926? \u0939\u092e\u093e\u0930\u093e \u0928\u093e\u092f\u0915 \u0905\u092c \u090f\u0915 \u091c\u093e\u0938\u0942\u0938\u0940 \u0916\u0947\u0932 \u092e\u0947\u0902 \u092b\u0902\u0938 \u0917\u092f\u093e \u0939\u0948, \u091c\u0939\u093e\u0902 \u0939\u0930 \u0915\u0926\u092e \u092a\u0930 \u0909\u0938\u0947 \u0905\u092a\u0928\u0940 \u091c\u093e\u0928 \u0915\u0940 \u092c\u093e\u091c\u0940 \u0932\u0917\u093e\u0928\u0940 \u0939\u094b\u0917\u0940\u0964 \u0935\u0939 \u090f\u0915 \u0938\u0947 \u092c\u0922\u093c\u0915\u0930 \u090f\u0915 \u0916\u0924\u0930\u0928\u093e\u0915 \u0938\u094d\u0925\u093f\u0924\u093f \u092e\u0947\u0902 \u092b\u0902\u0938\u0924\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948, \u0914\u0930 \u0909\u0938\u0915\u0947 \u092a\u093e\u0938 \u0938\u092e\u092f \u0915\u092e \u0939\u094b\u0924\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948\u0964 \u0905\u092c \u0909\u0938\u0947 \u0905\u092a\u0928\u0940 \u092c\u0941\u0926\u094d\u0927\u093f\u092e\u0924\u094d\u0924\u093e \u0914\u0930 \u0938\u093e\u0939\u0938 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0907\u0938 \u0916\u0924\u0930\u0928\u093e\u0915 \u0916\u0947\u0932 \u0938\u0947 \u092c\u093e\u0939\u0930 \u0928\u093f\u0915\u0932\u0928\u093e \u0939\u094b\u0917\u093e\u0964 \u0932\u0947\u0915\u093f\u0928 \u0915\u094d\u092f\u093e \u0935\u0939 \u0910\u0938\u093e \u0915\u0930 \u092a\u093e\u090f\u0917\u093e? \u0915\u094d\u092f\u093e \u0935\u0939 \u0905\u092a\u0928\u0940 \u091c\u093e\u0928 \u092c\u091a\u093e \u092a\u093e\u090f\u0917\u093e? \u092f\u093e \u092b\u093f\u0930 \u0935\u0939 \u0907\u0938 \u0916\u0924\u0930\u0928\u093e\u0915 \u0916\u0947\u0932 \u0915\u093e \u0634\u093f\u0915\u093e\u0930 \u0939\u094b \u091c\u093e\u090f\u0917\u093e? \u092f\u0939 \u0924\u094b \u0938\u092e\u092f \u0939\u0940 \u092c\u0924\u093e\u090f\u0917\u093e, \u0932\u0947\u0915\u093f\u0928 \u090f\u0915 \u092c\u093e\u0924 \u0924\u092f \u0939\u0948 - \u0907\u0938 \u0916\u0947\u0932 \u092e\u0947\u0902 \u0915\u094b\u0908 \u092d\u0940 \u0915\u093f\u0938\u0940 \u092a\u0930 \u092d\u0940 \u0935\u093f\u0936\u094d\u0935\u093e\u0938 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u093e\u0964 \u0939\u0930 \u0915\u094b\u0908 \u090f\u0915 \u0926\u0942\u0938\u0930\u0947 \u0915\u093e \u0926\u0941\u0936\u094d\u092e\u0928 \u0939\u0948, \u0914\u0930 \u092f\u0939 \u0916\u0947\u0932 \u0924\u092c \u0924\u0915 \u091c\u093e\u0930\u0940 \u0930\u0939\u0947\u0917\u093e \u091c\u092c \u0924\u0915 \u0915\u093f \u0915\u0947\u0935\u0932 \u090f\u0915 \u0939\u0940 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u092c\u091a\u093e \u0928\u0939\u0940\u0902 \u0930\u0939 \u091c\u093e\u0924\u093e\u0964 \u0924\u094b \u0906\u0907\u090f \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0906\u0917\u0947 \u0915\u094d\u092f\u093e \u0939\u094b\u0924\u093e \u0939\u0948, \u0914\u0930 \u0915\u094c\u0928 \u0938\u093e \u0930\u093e\u091c \u091b\u0941\u092a\u093e \u0939\u0948 \u0907\u0938 \u091c\u093e\u0938\u0942\u0938\u0940 \u0915\u0939\u093e\u0928\u0940 \u092e\u0947\u0902\u0964 \u0915\u094d\u092f\u093e \u0939\u092e\u093e\u0930\u093e \u0928\u093e\u092f\u0915 \u0938\u091achai \u0915\u093e \u092a\u0924\u093e \u0932\u0917\u093e \u092a\u093e\u090f\u0917\u093e, \u092f\u093e \u092b\u093f\u0930 \u0935\u0939 \u0907\u0938 \u0916\u0924\u0930\u0928\u093e\u0915 \u0916\u0947\u0932 \u0915\u093e \u0936\u093f\u0915\u093e\u0930 \u0939\u094b \u091c\u093e\u090f\u0917\u093e? \u092f\u0939 \u0924\u094b \u0938\u092e\u092f \u0939\u0940 \u092c\u0924\u093e\u090f\u0917\u093e\u0964",
